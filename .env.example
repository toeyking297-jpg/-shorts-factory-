# Copy of this file is .env  (open with Notepad, paste keys after =, save)
# Free key: log in at https://pixabay.com/api/docs/  -> your key is shown under "Parameters" (key)  (REQUIRED)
PIXABAY_API_KEY=
# Optional extra source. Pexels has paused new keys; leave empty if you don't have one.
PEXELS_API_KEY=
# Only if you switch voice.engine to "elevenlabs" in config/channel.json
ELEVENLABS_API_KEY=
# Automatic mode (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Trend radar (free): Google Cloud console -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=
